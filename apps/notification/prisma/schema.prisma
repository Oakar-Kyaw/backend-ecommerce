generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/notification" 
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DB_URL")
}

model NotificationToken {
  id         Int    @id @default(autoincrement())
  token      String
  role       Role   @default(CUSTOMER)
  userId     Int
  brandId    Int?
  branchId   Int?
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int?
  brandId     Int?
  title       String
  body        String
  type        String?
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  role       String
  phone      String
  userId     Int           @unique
  isDeleted  Boolean                @default(false)
}

enum Role {
  CUSTOMER
  ADMIN
  SALE
}