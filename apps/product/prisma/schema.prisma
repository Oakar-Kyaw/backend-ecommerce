// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/product" 
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCT_DB_URL")
}

model Category {
  id                      Int                    @id @default(autoincrement())
  title                   String
  description             String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  isDeleted   Boolean                @default(false)
  subCategories           SubCategory[]
  products                Product[]
  photoUrl                String?

  @@unique([title, isDeleted])
  @@index([isDeleted])
}

model SubCategory {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@unique([title, categoryId, isDeleted])
  @@index([isDeleted])
  @@index([categoryId])
}

model Product {
  id              Int         @id @default(autoincrement())
  name            String
  code            String      @unique
  type            String
  weight          String
  discountPercent Float
  description     String
  mainImage       String
  userCount       Int?      @default(0)
  
  brandId         Int       @default(1) // Default for existing items, or make it optional? Let's make it Int but we might need a default or nullable for migration. Let's try just Int and see if migration complains, or make it optional first? No, user wants it to be part of creation. I'll make it Int.
  
  categoryId      Int
  category        Category    @relation(fields: [categoryId], references: [id])
  
  subCategoryId   Int?
  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  
  isDeleted       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  colors          ProductColor[]
  sizes           ProductSize[]
  variants        ProductVariant[]
  userFavorites   UserFavorite[] 
  cartItems       AddToCart[]
}

model ProductColor {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  
  imageFront String?
  imageBack  String?
  imageSideL String?
  imageSideR String?

  variants  ProductVariant[]
}

model Currency {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  symbol       String
  exchangeRate Float
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductSize {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Float

  variants  ProductVariant[]
}

model ProductVariant {
  id             Int          @id @default(autoincrement())
  productId      Int
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  productSizeId  Int
  productSize    ProductSize  @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  
  productColorId Int
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  
  quantity       Int          @default(0)

  @@unique([productSizeId, productColorId])
}

model ShippingFee {
  id         Int       @id @default(autoincrement())
  country    String
  weightKg   Float
  price      Int
  currency   String    @default("MMK")
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([country, weightKg, isDeleted])
  @@index([country, isDeleted])
}

model UserFavorite {
  id        Int     @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([userId, productId]) 
}

model AddToCart {
  id        Int     @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@unique([userId, productId]) // Composite unique to prevent duplicates
}


model User {
  id                      Int                    @id @default(autoincrement())
  userId                  Int                    @unique
  email                   String                 @unique
  phone                   String?                 
  isDeleted               Boolean                @default(false)
  role                    String
  favorites               UserFavorite[]   
  cartItems               AddToCart[]  
}